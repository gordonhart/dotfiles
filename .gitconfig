[user]
name = Gordon Hart
email = gordon.hart2@gmail.com

[credential]
helper = store

[alias]
ca = commit --amend
cerise = cherry-pick
stauts = status
stuats = status
ct = checkout trunk
p = pull

[pull]
ff = only

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	autoSetupRemote = true
